 <dl class="mt-8 space-y-8">
 {faqs.map((faq) => (
 <div>
 <dt class="font-semibold text-slate-950">{faq.q}</dt>
 <dd class="mt-2 text-slate-600 leading-relaxed">{faq.a}</dd>
 </div>
 ))}
 </dl>
 </div>
 </section>

 <section class="bg-white px-5 py-12 lg:px-8">
 <div class="mx-auto max-w-3xl">
 <p class="text-sm font-semibold text-slate-500">Related reading</p>
 <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
