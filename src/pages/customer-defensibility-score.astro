<script>
 // ─── Data ───────────────────────────────────────────────────────────────────

 const RISK_POINTS: Record<string, Record<string, number>> = {
 q4: { A: 3, B: 2, C: 5, D: 0, E: 5 },
 q5: { A: 5, B: 4, C: 2, D: 0, E: 3 },
 q6: { A: 5, B: 4, C: 3, D: 3, E: 0 },
 q7: { A: 5, B: 4, C: 2, D: 1, E: 0 },
 q8: { A: 5, B: 4, C: 2, D: 1, E: 0 },
 q9: { A: 5, B: 5, C: 4, D: 2, E: 0 },
 q10: { A: 0, B: 3, C: 5, D: 5, E: 4 },
 };

 const COMPLEXITY_CUSTOMER: Record<string, number> = { A: 1, B: 2, C: 3, D: 4, E: 5 };
 const COMPLEXITY_ACV: Record<string, number> = { A: 1, B: 2, C: 3, D: 4, E: 5 };

 const PROFILE_MAP: Record<string, Record<string, Record<string, number>>> = {
 q4: { A: {p5:2,p1:1}, B: {p2:2}, C: {p3:2,p5:1}, D: {}, E: {p5:3} },
 q5: { A: {p1:3,p5:1}, B: {p5:2,p1:1}, C: {p5:1}, D: {}, E: {p5:2} },
 q6: { A: {p2:3,p1:1}, B: {p2:3}, C: {p5:2,p2:1}, D: {p2:2}, E: {} },
 q7: { A: {p4:3}, B: {p4:3}, C: {p4:1}, D: {}, E: {} },
 q8: { A: {p3:2,p1:1}, B: {p5:2,p3:1}, C: {p2:1}, D: {}, E: {} },
 q9: { A: {p3:4}, B: {p3:4}, C: {p3:3,p2:1}, D: {p3:1}, E: {} },
 q10: { A: {}, B: {p5:1,p2:1}, C: {p3:2,p5:1}, D: {p5:3,p3:1}, E: {p5:3} },
 };

 const PROFILES: Record<string, { name: string; desc: string; warnings: string[]; actions: string[] }> = {
 p1: {
 name: 'Ticket Closure Trap',
 desc: 'Your team may be resolving issues faster than it is interpreting value risk. Support metrics like response time and CSAT matter, but they may not reveal whether an account is becoming more or less defensible.',
 warnings: [
 'Accounts with repeated tickets around the same workflow may be going unnoticed',
 'Tickets are being closed while the underlying adoption problem remains open',
 'Support queues can look healthy while account-level confidence is weakening',
 ],
 actions: [
 'Connect support patterns to account health, product area, and renewal timing',
 'Review strategic accounts for repeated tickets tied to unresolved adoption gaps',
 'Track which support patterns appear before churn, contraction, or renewal pushback',
 ],
 },
 p2: {
 name: 'Hidden Adoption Friction',
 desc: 'Your biggest risk may be repeated workflow friction that weakens adoption over time. The product may be used, but customers may still be struggling with the workflows that matter most.',
 warnings: [
 'Repeated post-onboarding questions may signal stalled activation in key accounts',
 'Workarounds and configuration confusion often precede value decay',
 'Product-area friction may not be visible at the account level until it is too late',
 ],
 actions: [
 'Map repeated product friction to specific workflows and activation gaps',
 'Identify high-ARR accounts with repeated questions after onboarding',
 'Connect product-area friction to renewal timing and ARR exposure',
 ],
 },
 p3: {
 name: 'Weak Renewal Defensibility',
 desc: 'Your customers may like the product, but they may not have enough proof to defend it internally. Customers do not renew software they like, they renew software they can defend.',
 warnings: [
 'Champions may not have evidence beyond anecdotes or relationship strength',
 'Accounts that feel healthy could be vulnerable in a budget or procurement review',
 'Value is difficult to prove internally without your team in the room',
 ],
 actions: [
 'Build a renewal defensibility view for accounts approaching budget scrutiny',
 'Document adoption, outcomes, and workflow impact by account before renewal',
 'Identify which accounts could not survive a budget review unassisted',
 ],
 },
 p4: {
 name: 'Expansion Signals Lost in Support',
 desc: 'Your support queue may contain growth signals that are not reaching the right teams. Expansion often appears first as a support question, about permissions, integrations, new teams, or advanced workflows.',
 warnings: [
 'Access, permission, and integration requests may not be reaching revenue teams',
 'New team onboarding often appears first as a support request',
 'Growth moments are being treated as routine tickets rather than revenue signals',
 ],
 actions: [
 'Create routing rules for support topics that indicate expansion intent',
 'Train support teams to identify and tag growth opportunities',
 'Connect expansion signal patterns to CS and revenue team workflows',
 ],
 },
 p5: {
 name: 'Fragmented Value Intelligence',
 desc: 'Your post-sale signals exist, but they may be scattered across teams and systems. Support sees friction. CS sees relationship context. Product sees usage. But no team has a complete picture.',
 warnings: [
 'Risk looks different in each team\'s system, making it easy to miss',
 'Accounts can appear healthy in one view but high-risk in another',
 'Late risk discovery often results from signals sitting in disconnected silos',
 ],
 actions: [
 'Identify the earliest signals of value decay across all your systems',
 'Build an account-level view connecting support, onboarding, adoption, and renewal signals',
 'Create a shared definition of what account health means across all teams',
 ],
 },
 };

 const BANDS = [
 { min: 85, label: 'Strong Defensibility', desc: 'You likely have good visibility into whether value is strengthening or weakening.', color: '#10b981', badgeBg: '#d1fae5', badgeText: '#065f46' },
 { min: 70, label: 'Emerging Risk', desc: 'You have some visibility, but important value decay signals may still be missed.', color: '#f59e0b', badgeBg: '#fef3c7', badgeText: '#92400e' },
 { min: 50, label: 'Moderate Value Decay Risk', desc: 'Your customer base may contain accounts that look stable but are becoming harder to defend.', color: '#f97316', badgeBg: '#ffedd5', badgeText: '#9a3412' },
 { min: 0, label: 'High Value Decay Risk', desc: 'Your team may be discovering value decay too late, after it has already become renewal or contraction risk.', color: '#ef4444', badgeBg: '#fee2e2', badgeText: '#991b1b' },
 ];

 const ROLE_CONTEXT: Record<string, string> = {
 A: 'As a Founder or CEO, your primary concern is revenue exposure, retention, and SaaS defensibility across the customer base.',
 B: 'As a CS leader, this surfaces your exposure across account health, renewal risk, adoption gaps, and champion strength.',
 C: 'As a Support leader, this highlights ticket patterns, support visibility, and where AI support operations risk may be hiding.',
 D: 'As a Revenue leader, this surfaces the ARR exposure hidden in your post-sale operations.',
 E: 'As a Product leader, this identifies product-area friction and roadmap signals coming from your customer base.',
 F: 'This assessment surfaces where value may be decaying across support, adoption, and renewal in your customer base.',
 };

 // ─── State ──────────────────────────────────────────────────────────────────

 const answers: Record<string, string> = {};
 let currentScreen = 0;

 // Screen question requirements
 const SCREEN_QUESTIONS: Record<number, string[]> = {
 1: ['q1', 'q2', 'q3'],
 2: ['q4', 'q5'],
 3: ['q6', 'q7', 'q8'],
 4: ['q9', 'q10'],
 };

 const SCREEN_LABELS: Record<number, [string, string, number]> = {
 1: ['Your context', 'Questions 1–3', 20],
 2: ['Risk detection', 'Questions 4–5', 40],
 3: ['Value signal detection', 'Questions 6–8', 60],
 4: ['Renewal defensibility', 'Questions 9–10', 80],
 5: ['Almost done', '', 95],
 };

 // ─── Navigation ─────────────────────────────────────────────────────────────

 function goTo(n: number) {
 document.getElementById(`s${currentScreen}`)!.classList.add('hidden');
 currentScreen = n;
 const screen = document.getElementById(`s${n}`)!;
 screen.classList.remove('hidden');
 window.scrollTo({ top: 0, behavior: 'smooth' });
 updateProgress(n);
 }

 function updateProgress(n: number) {
 const wrap = document.getElementById('progress-wrap')!;
 if (n === 0 || n === 6) { wrap.classList.add('hidden'); return; }
 wrap.classList.remove('hidden');
 const [label, count, pct] = SCREEN_LABELS[n] ?? ['', '', 0];
 document.getElementById('progress-label')!.textContent = label;
 document.getElementById('progress-count')!.textContent = count;
 (document.getElementById('progress-fill') as HTMLElement).style.width = `${pct}%`;
 }

 // ─── Option selection ────────────────────────────────────────────────────────

 function handleOptionClick(btn: HTMLElement) {
 const q = btn.dataset.q!;
 const v = btn.dataset.v!;
 // Deselect siblings
 document.querySelectorAll<HTMLElement>(`.opt-btn[data-q="${q}"]`).forEach(b => b.classList.remove('selected'));
 btn.classList.add('selected');
 answers[q] = v;
 // Check if current screen's questions are all answered
 const screenNum = currentScreen;
 const required = SCREEN_QUESTIONS[screenNum] ?? [];
 const allAnswered = required.every(qid => answers[qid]);
 const nextBtn = document.getElementById(`next-${screenNum}`) as HTMLButtonElement | null;
 if (nextBtn) nextBtn.disabled = !allAnswered;
 }

 // ─── Scoring ─────────────────────────────────────────────────────────────────

 function calcScore(): number {
 let risk = 0;
 for (const q of ['q4','q5','q6','q7','q8','q9','q10']) {
 risk += RISK_POINTS[q]?.[answers[q]] ?? 0;
 }
 const complexSum = (COMPLEXITY_CUSTOMER[answers.q2] ?? 0) + (COMPLEXITY_ACV[answers.q3] ?? 0);
 let penalty = 0;
 if (complexSum >= 9) penalty = 8;
 else if (complexSum >= 7) penalty = 5;
 else if (complexSum >= 5) penalty = 3;
 return Math.max(0, 100 - risk - penalty);
 }

 function calcProfiles(): Record<string, number> {
 const p: Record<string, number> = { p1: 0, p2: 0, p3: 0, p4: 0, p5: 0 };
 for (const q of ['q4','q5','q6','q7','q8','q9','q10']) {
 const pts = PROFILE_MAP[q]?.[answers[q]] ?? {};
 for (const [k, v] of Object.entries(pts)) p[k] = (p[k] ?? 0) + (v as number);
 }
 // Modifiers
 if (['D','E'].includes(answers.q2)) p.p5 += 1;
 if (['D','E'].includes(answers.q3)) p.p3 += 1;
 if (answers.q1 === 'A') p.p3 += 1;
 if (answers.q1 === 'B') p.p3 += 1;
 if (answers.q1 === 'C') p.p1 += 1;
 if (answers.q1 === 'D') p.p5 += 1;
 return p;
 }

 function getDominantProfile(p: Record<string, number>): string {
 const max = Math.max(...Object.values(p));
 const tied = Object.entries(p).filter(([, v]) => v === max).map(([k]) => k);
 if (tied.length === 1) return tied[0];

 // Tie-breakers
 if (tied.includes('p3') && ['A','B','C'].includes(answers.q9)) return 'p3';
 if (tied.includes('p5') && (tied.includes('p1') || tied.includes('p2'))) {
 if (['E'].includes(answers.q4) || answers.q5 === 'E' || ['D','E'].includes(answers.q10)) return 'p5';
 }
 if (tied.includes('p1') && tied.includes('p2')) {
 return ['A','B','D'].includes(answers.q6) ? 'p2' : 'p1';
 }
 if (tied.includes('p4') && tied.length > 1) {
 const other = tied.find(p => p !== 'p4' && ['p3','p5'].includes(p));
 if (other) return other;
 }
 return tied[0];
 }

 // ─── Render results ──────────────────────────────────────────────────────────

 function renderResults() {
 const score = calcScore();
 const profiles = calcProfiles();
 const profileKey = getDominantProfile(profiles);
 const profile = PROFILES[profileKey];
 const band = BANDS.find(b => score >= b.min)!;

 // Score ring
 document.getElementById('score-number')!.textContent = String(score);
 const ring = document.getElementById('score-ring')!;
 ring.style.boxShadow = `inset 0 0 0 10px ${band.color}22, 0 0 0 0px transparent`;
 ring.style.border = `10px solid ${band.color}`;

 // Band
 const badge = document.getElementById('score-band-badge')!;
 badge.textContent = band.label;
 badge.style.background = band.badgeBg;
 badge.style.color = band.badgeText;
 document.getElementById('score-band-label')!.textContent = band.label;
 document.getElementById('score-band-desc')!.textContent = band.desc;
 document.getElementById('score-role-context')!.textContent = ROLE_CONTEXT[answers.q1] ?? ROLE_CONTEXT.F;

 // Profile
 document.getElementById('profile-name')!.textContent = profile.name;
 document.getElementById('profile-desc')!.textContent = profile.desc;

 // Warnings
 const warnEl = document.getElementById('warnings-list')!;
 warnEl.innerHTML = profile.warnings.map(w =>
 `<li class="flex items-start gap-3 text-sm text-amber-900">
 <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-amber-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
 ${w}
 </li>`
 ).join('');

 // Actions
 const actEl = document.getElementById('actions-list')!;
 actEl.innerHTML = profile.actions.map(a =>
 `<li class="flex items-start gap-3 text-sm text-blue-900">
 <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
 ${a}
 </li>`
 ).join('');
 }

 // ─── Netlify submission ──────────────────────────────────────────────────────

 async function submitToNetlify(email: string, company: string, name: string) {
 const score = calcScore();
 const profiles = calcProfiles();
 const profileKey = getDominantProfile(profiles);
 const band = BANDS.find(b => score >= b.min)!;

 const data: Record<string, string> = {
 'form-name': 'customer-defensibility-score',
 email, company,
 'full-name': name,
 q1: answers.q1 ?? '', q2: answers.q2 ?? '', q3: answers.q3 ?? '',
 q4: answers.q4 ?? '', q5: answers.q5 ?? '', q6: answers.q6 ?? '',
 q7: answers.q7 ?? '', q8: answers.q8 ?? '', q9: answers.q9 ?? '',
 q10: answers.q10 ?? '',
 score: String(score),
 'score-band': band.label,
 profile: PROFILES[profileKey]?.name ?? profileKey,
 };

 try {
 await fetch('/', {
 method: 'POST',
 headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
 body: Object.entries(data).map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&'),
 });
 } catch (_) { /* fail silently, still show results */ }
 }

 // ─── Wire up events ──────────────────────────────────────────────────────────

 document.getElementById('start-btn')!.addEventListener('click', () => goTo(1));

 document.querySelectorAll<HTMLElement>('.opt-btn').forEach(btn => {
 btn.addEventListener('click', () => handleOptionClick(btn));
 });

 // Next buttons
 for (let i = 1; i <= 4; i++) {
 document.getElementById(`next-${i}`)?.addEventListener('click', () => goTo(i + 1));
 }

 // Back buttons
 document.getElementById('back-1')?.addEventListener('click', () => goTo(0));
 document.getElementById('back-2')?.addEventListener('click', () => goTo(1));
 document.getElementById('back-3')?.addEventListener('click', () => goTo(2));
 document.getElementById('back-4')?.addEventListener('click', () => goTo(3));
 document.getElementById('back-5')?.addEventListener('click', () => goTo(4));

 // ─── Signal Review Modal ────────────────────────────────────────────────────

 const signalModal = document.getElementById('signal-modal')!;
 const openSignalModal = () => { signalModal.classList.replace('hidden', 'flex'); signalModal.removeAttribute('aria-hidden'); };
 const closeSignalModal = () => { signalModal.classList.replace('flex', 'hidden'); signalModal.setAttribute('aria-hidden', 'true'); };

 document.getElementById('open-signal-modal')?.addEventListener('click', () => {
 // Pre-fill from quiz email capture
 const nameEl = document.getElementById('sr-name') as HTMLInputElement;
 const emailEl = document.getElementById('sr-email') as HTMLInputElement;
 const companyEl = document.getElementById('sr-company') as HTMLInputElement;
 if (!nameEl.value) nameEl.value = (document.getElementById('input-name') as HTMLInputElement)?.value ?? '';
 if (!emailEl.value) emailEl.value = (document.getElementById('input-email') as HTMLInputElement)?.value ?? '';
 if (!companyEl.value) companyEl.value = (document.getElementById('input-company') as HTMLInputElement)?.value ?? '';
 openSignalModal();
 });

 document.getElementById('signal-modal-close')!.addEventListener('click', closeSignalModal);
 document.getElementById('signal-modal-done')!.addEventListener('click', closeSignalModal);
 signalModal.addEventListener('click', (e) => { if (e.target === signalModal) closeSignalModal(); });

 document.getElementById('signal-review-form')!.addEventListener('submit', async (e) => {
 e.preventDefault();
 const email = (document.getElementById('sr-email') as HTMLInputElement).value.trim();
 const company = (document.getElementById('sr-company') as HTMLInputElement).value.trim();
 const name = (document.getElementById('sr-name') as HTMLInputElement).value.trim();
 const focus = (document.getElementById('sr-focus') as HTMLTextAreaElement).value.trim();
 const errEl = document.getElementById('sr-error')!;

 if (!email || !company || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
 errEl.classList.remove('hidden');
 return;
 }
 errEl.classList.add('hidden');

 const btn = document.getElementById('sr-submit') as HTMLButtonElement;
 btn.disabled = true;
 btn.textContent = 'Sending...';

 const score = calcScore();
 const profileKey = getDominantProfile(calcProfiles());
 const band = BANDS.find(b => score >= b.min)!;

 const data: Record<string, string> = {
 'form-name': 'signal-review-request',
 email, company,
 'full-name': name,
 score: String(score),
 'profile': PROFILES[profileKey]?.name ?? profileKey,
 'score-band': band.label,
 focus,
 };

 try {
 await fetch('/', {
 method: 'POST',
 headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
 body: Object.entries(data).map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&'),
 });
 } catch (_) { /* fail silently */ }

 document.getElementById('signal-modal-form-state')!.classList.add('hidden');
 document.getElementById('signal-modal-confirm-state')!.classList.remove('hidden');
 });

 // Email form
 document.getElementById('email-form')!.addEventListener('submit', async (e) => {
 e.preventDefault();
 const email = (document.getElementById('input-email') as HTMLInputElement).value.trim();
 const company = (document.getElementById('input-company') as HTMLInputElement).value.trim();
 const name = (document.getElementById('input-name') as HTMLInputElement).value.trim();
 const errEl = document.getElementById('email-error')!;

 if (!email || !company || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
 errEl.classList.remove('hidden');
 return;
 }
 errEl.classList.add('hidden');

 const btn = document.getElementById('submit-email') as HTMLButtonElement;
 btn.disabled = true;
 btn.textContent = 'Loading...';

 await submitToNetlify(email, company, name);
 renderResults();
 goTo(6);
 });
</script>
