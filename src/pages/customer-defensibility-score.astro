---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Customer Defensibility Score | Meridian";
const pageDescription = "Find out how defensible your B2B SaaS customers really are. Take the 3-minute Customer Defensibility Score assessment to identify where value may be decaying across support, adoption, and renewal.";
const canonical = "https://meridianarr.com/customer-defensibility-score/";
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
 <Nav />

 <!-- Hidden Netlify form for bot detection -->
 <form name="customer-defensibility-score" data-netlify="true" netlify-honeypot="bot-field" hidden>
 <input name="bot-field" />
 <input name="email" />
 <input name="company" />
 <input name="full-name" />
 <input name="q1" /><input name="q2" /><input name="q3" />
 <input name="q4" /><input name="q5" /><input name="q6" />
 <input name="q7" /><input name="q8" /><input name="q9" />
 <input name="q10" />
 <input name="score" />
 <input name="score-band" />
 <input name="profile" />
 </form>

 <main class="min-h-screen bg-white">

 <!-- Progress Bar -->
 <div id="progress-wrap" class="hidden sticky top-[73px] z-30 border-b border-slate-100 bg-white/95 backdrop-blur-sm">
 <div class="mx-auto max-w-2xl px-5 py-3 lg:px-8">
 <div class="mb-1.5 flex items-center justify-between">
 <span id="progress-label" class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-700"></span>
 <span id="progress-count" class="text-xs font-medium text-slate-400"></span>
 </div>
 <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
 <div id="progress-fill" class="h-full rounded-full bg-slate-950 transition-all duration-500" style="width:0%"></div>
 </div>
 </div>
 </div>

 <!-- ===================== SCREEN 0: INTRO ===================== -->
 <div id="s0" class="screen">
 <section class="relative overflow-hidden bg-[linear-gradient(135deg,#ffffff_0%,#f4f7fb_52%,#eef6ff_100%)] px-5 py-10 lg:px-8 lg:py-16">
 <div class="absolute right-[-8%] top-[-12%] h-[480px] w-[480px] rounded-full bg-blue-100/60 blur-3xl"></div>
 <div class="absolute bottom-[-12%] left-[-6%] h-[360px] w-[360px] rounded-full bg-teal-100/50 blur-3xl"></div>
 <div class="relative mx-auto max-w-3xl text-center">
 <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-blue-700 shadow-sm">
 Customer Defensibility Score
 </span>
 <h1 class="mt-5 text-5xl font-semibold tracking-[-0.05em] text-slate-950 lg:text-6xl">
 Can your customers defend your product when it matters?
 </h1>
 <p class="mx-auto mt-4 max-w-2xl text-xl leading-8 text-slate-600">
 Budget scrutiny, vendor consolidation, and AI automation are forcing customers to justify every product in the stack. This diagnostic identifies where value may be strengthening or decaying across support, onboarding, adoption, expansion, and renewal.
 </p>
 <div class="mt-6 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
 <div class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 shadow-sm">
 <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
 3 minutes
 </div>
 <div class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 shadow-sm">
 <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19V5"/><path d="M4 19h16"/><rect x="7" y="11" width="3" height="5" rx="1"/><rect x="12" y="8" width="3" height="8" rx="1"/><rect x="17" y="5" width="3" height="11" rx="1"/></svg>
 10 questions
 </div>
 <div class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 shadow-sm">
 <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
 Score + risk profile
 </div>
 </div>
 <button
 id="start-btn"
 type="button"
 class="mt-6 inline-flex items-center justify-center rounded-full bg-slate-950 px-10 py-4 text-base font-semibold text-white transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
 >
 Get My Score
 <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
 </button>
 </div>
 </section>
 </div>

 <!-- ===================== SCREEN 1: SEGMENTATION (Q1–Q3) ===================== -->
 <div id="s1" class="screen hidden">
 <div class="mx-auto max-w-2xl px-5 py-16 lg:px-8">
 <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">Your context</p>
 <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-slate-950">Let's personalize your results.</h2>
 <p class="mt-3 text-base text-slate-500">Three quick questions to tailor the output to your role and customer base.</p>

 <div class="mt-10" data-group="q1">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 1 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">What is your role?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q1" data-v="A"><span class="opt-letter">A</span><span>Founder / CEO</span></button>
 <button class="opt-btn" data-q="q1" data-v="B"><span class="opt-letter">B</span><span>Chief Customer Officer / VP Customer Success</span></button>
 <button class="opt-btn" data-q="q1" data-v="C"><span class="opt-letter">C</span><span>VP / Head of Support</span></button>
 <button class="opt-btn" data-q="q1" data-v="D"><span class="opt-letter">D</span><span>Revenue / RevOps Leader</span></button>
 <button class="opt-btn" data-q="q1" data-v="E"><span class="opt-letter">E</span><span>Product Leader</span></button>
 <button class="opt-btn" data-q="q1" data-v="F"><span class="opt-letter">F</span><span>Other</span></button>
 </div>
 </div>

 <div class="mt-10" data-group="q2">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 2 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">How many B2B customers do you support?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q2" data-v="A"><span class="opt-letter">A</span><span>Fewer than 25</span></button>
 <button class="opt-btn" data-q="q2" data-v="B"><span class="opt-letter">B</span><span>25–100</span></button>
 <button class="opt-btn" data-q="q2" data-v="C"><span class="opt-letter">C</span><span>101–500</span></button>
 <button class="opt-btn" data-q="q2" data-v="D"><span class="opt-letter">D</span><span>501–2,000</span></button>
 <button class="opt-btn" data-q="q2" data-v="E"><span class="opt-letter">E</span><span>More than 2,000</span></button>
 </div>
 </div>

 <div class="mt-10" data-group="q3">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 3 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">What is your average contract size?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q3" data-v="A"><span class="opt-letter">A</span><span>Under $5K ARR</span></button>
 <button class="opt-btn" data-q="q3" data-v="B"><span class="opt-letter">B</span><span>$5K–$25K ARR</span></button>
 <button class="opt-btn" data-q="q3" data-v="C"><span class="opt-letter">C</span><span>$25K–$100K ARR</span></button>
 <button class="opt-btn" data-q="q3" data-v="D"><span class="opt-letter">D</span><span>$100K–$250K ARR</span></button>
 <button class="opt-btn" data-q="q3" data-v="E"><span class="opt-letter">E</span><span>$250K+ ARR</span></button>
 </div>
 </div>

 <div class="mt-10 flex items-center justify-between">
 <button id="back-1" type="button" class="nav-back-btn">
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m11 5-7 7 7 7"/></svg>
 Back
 </button>
 <button id="next-1" type="button" disabled class="nav-next-btn">
 Continue
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
 </button>
 </div>
 </div>
 </div>

 <!-- ===================== SCREEN 2: RISK DETECTION (Q4–Q5) ===================== -->
 <div id="s2" class="screen hidden">
 <div class="mx-auto max-w-2xl px-5 py-16 lg:px-8">
 <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">Current risk detection</p>
 <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-slate-950">How do you currently identify risk?</h2>
 <p class="mt-3 text-base text-slate-500">These questions diagnose whether you have an early-warning system or are relying on lagging indicators.</p>

 <div class="mt-10" data-group="q4">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 4 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">How do you currently identify renewal risk?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q4" data-v="A"><span class="opt-letter">A</span><span>Mostly through CSM judgment, account notes, or QBRs</span></button>
 <button class="opt-btn" data-q="q4" data-v="B"><span class="opt-letter">B</span><span>Mostly through usage dashboards or health scores</span></button>
 <button class="opt-btn" data-q="q4" data-v="C"><span class="opt-letter">C</span><span>Mostly when customers escalate, go quiet, or push back near renewal</span></button>
 <button class="opt-btn" data-q="q4" data-v="D"><span class="opt-letter">D</span><span>Through connected support, product, CS, and renewal signals</span></button>
 <button class="opt-btn" data-q="q4" data-v="E"><span class="opt-letter">E</span><span>We do not have a consistent process</span></button>
 </div>
 </div>

 <div class="mt-10" data-group="q5">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 5 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">Do support tickets connect to account health today?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q5" data-v="A"><span class="opt-letter">A</span><span>No, tickets are mostly managed separately from account health</span></button>
 <button class="opt-btn" data-q="q5" data-v="B"><span class="opt-letter">B</span><span>Partially, but mostly through manual notes or CSM interpretation</span></button>
 <button class="opt-btn" data-q="q5" data-v="C"><span class="opt-letter">C</span><span>Yes, support activity is visible in account health dashboards</span></button>
 <button class="opt-btn" data-q="q5" data-v="D"><span class="opt-letter">D</span><span>Yes, and support patterns influence risk, adoption, and renewal views</span></button>
 <button class="opt-btn" data-q="q5" data-v="E"><span class="opt-letter">E</span><span>Not sure</span></button>
 </div>
 </div>

 <div class="mt-10 flex items-center justify-between">
 <button id="back-2" type="button" class="nav-back-btn">
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m11 5-7 7 7 7"/></svg>
 Back
 </button>
 <button id="next-2" type="button" disabled class="nav-next-btn">
 Continue
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
 </button>
 </div>
 </div>
 </div>

 <!-- ===================== SCREEN 3: VALUE SIGNALS (Q6–Q8) ===================== -->
 <div id="s3" class="screen hidden">
 <div class="mx-auto max-w-2xl px-5 py-16 lg:px-8">
 <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">Value signal detection</p>
 <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-slate-950">What signals can your team see?</h2>
 <p class="mt-3 text-base text-slate-500">These questions diagnose adoption friction, expansion opportunities, and disengagement visibility.</p>

 <div class="mt-10" data-group="q6">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 6 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">Can you identify repeated friction by account and product area?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q6" data-v="A"><span class="opt-letter">A</span><span>No, we mostly look at tickets individually</span></button>
 <button class="opt-btn" data-q="q6" data-v="B"><span class="opt-letter">B</span><span>Sometimes, but it requires manual analysis</span></button>
 <button class="opt-btn" data-q="q6" data-v="C"><span class="opt-letter">C</span><span>We can see repeated issues by account, but not by product area</span></button>
 <button class="opt-btn" data-q="q6" data-v="D"><span class="opt-letter">D</span><span>We can see repeated issues by product area, but not tied clearly to account risk</span></button>
 <button class="opt-btn" data-q="q6" data-v="E"><span class="opt-letter">E</span><span>Yes, we can identify repeated friction by account, product area, and risk impact</span></button>
 </div>
 </div>

 <div class="mt-10" data-group="q7">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 7 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">Do you know when support activity signals expansion?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q7" data-v="A"><span class="opt-letter">A</span><span>No, support requests are not usually reviewed for expansion signals</span></button>
 <button class="opt-btn" data-q="q7" data-v="B"><span class="opt-letter">B</span><span>Sometimes, if a CSM or support rep notices manually</span></button>
 <button class="opt-btn" data-q="q7" data-v="C"><span class="opt-letter">C</span><span>We track some expansion-related keywords or requests</span></button>
 <button class="opt-btn" data-q="q7" data-v="D"><span class="opt-letter">D</span><span>We route certain support signals to CS or sales</span></button>
 <button class="opt-btn" data-q="q7" data-v="E"><span class="opt-letter">E</span><span>Yes, expansion signals from support are systematically captured and acted on</span></button>
 </div>
 </div>

 <div class="mt-10" data-group="q8">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 8 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">Do you know when quiet accounts are healthy versus disengaged?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q8" data-v="A"><span class="opt-letter">A</span><span>No, low support volume is often assumed to be good</span></button>
 <button class="opt-btn" data-q="q8" data-v="B"><span class="opt-letter">B</span><span>Not reliably; we usually need CSM judgment</span></button>
 <button class="opt-btn" data-q="q8" data-v="C"><span class="opt-letter">C</span><span>We compare support activity with usage data</span></button>
 <button class="opt-btn" data-q="q8" data-v="D"><span class="opt-letter">D</span><span>We compare support activity, usage, onboarding, and renewal context</span></button>
 <button class="opt-btn" data-q="q8" data-v="E"><span class="opt-letter">E</span><span>Yes, we have a clear way to distinguish maturity from disengagement</span></button>
 </div>
 </div>

 <div class="mt-10 flex items-center justify-between">
 <button id="back-3" type="button" class="nav-back-btn">
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m11 5-7 7 7 7"/></svg>
 Back
 </button>
 <button id="next-3" type="button" disabled class="nav-next-btn">
 Continue
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
 </button>
 </div>
 </div>
 </div>

 <!-- ===================== SCREEN 4: RENEWAL DEFENSIBILITY (Q9–Q10) ===================== -->
 <div id="s4" class="screen hidden">
 <div class="mx-auto max-w-2xl px-5 py-16 lg:px-8">
 <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">Renewal defensibility</p>
 <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-slate-950">Can your customers prove value?</h2>
 <p class="mt-3 text-base text-slate-500">This is the core question. Can your champions defend the product when budget, procurement, or consolidation comes up?</p>

 <div class="mt-10" data-group="q9">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 9 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">Can your champions prove product value before renewal?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q9" data-v="A"><span class="opt-letter">A</span><span>Not consistently</span></button>
 <button class="opt-btn" data-q="q9" data-v="B"><span class="opt-letter">B</span><span>Only through anecdotes or relationship strength</span></button>
 <button class="opt-btn" data-q="q9" data-v="C"><span class="opt-letter">C</span><span>Sometimes, but proof usually has to be assembled manually</span></button>
 <button class="opt-btn" data-q="q9" data-v="D"><span class="opt-letter">D</span><span>Yes, for strategic accounts, but not across the full base</span></button>
 <button class="opt-btn" data-q="q9" data-v="E"><span class="opt-letter">E</span><span>Yes, we can show adoption, outcomes, and value evidence before renewal</span></button>
 </div>
 </div>

 <div class="mt-10" data-group="q10">
 <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Question 10 of 10</p>
 <h3 class="text-lg font-semibold text-slate-950">How often are churn risks discovered too late?</h3>
 <div class="mt-4 flex flex-col gap-2.5">
 <button class="opt-btn" data-q="q10" data-v="A"><span class="opt-letter">A</span><span>Rarely; we usually see risk early enough to act</span></button>
 <button class="opt-btn" data-q="q10" data-v="B"><span class="opt-letter">B</span><span>Sometimes; a few accounts surprise us each quarter</span></button>
 <button class="opt-btn" data-q="q10" data-v="C"><span class="opt-letter">C</span><span>Often; risk usually becomes clear near renewal</span></button>
 <button class="opt-btn" data-q="q10" data-v="D"><span class="opt-letter">D</span><span>Very often; churn or contraction can feel sudden</span></button>
 <button class="opt-btn" data-q="q10" data-v="E"><span class="opt-letter">E</span><span>Not sure</span></button>
 </div>
 </div>

 <div class="mt-10 flex items-center justify-between">
 <button id="back-4" type="button" class="nav-back-btn">
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m11 5-7 7 7 7"/></svg>
 Back
 </button>
 <button id="next-4" type="button" disabled class="nav-next-btn">
 Continue
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
 </button>
 </div>
 </div>
 </div>

 <!-- ===================== SCREEN 5: EMAIL CAPTURE ===================== -->
 <div id="s5" class="screen hidden">
 <div class="mx-auto max-w-2xl px-5 py-16 lg:px-8">
 <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center">
 <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-blue-700 shadow-sm">
 Your score is ready
 </span>
 <h2 class="mt-6 text-3xl font-semibold tracking-[-0.04em] text-slate-950">
 Your Customer Defensibility Score is ready.
 </h2>
 <p class="mt-4 text-base leading-7 text-slate-600">
 Enter your work email to receive your score, risk profile, and recommended next steps.
 </p>
 </div>

 <form id="email-form" class="mt-8 flex flex-col gap-4" novalidate>
 <div class="grid gap-4 sm:grid-cols-2">
 <input
 id="input-email"
 type="email"
 placeholder="Work email *"
 required
 class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
 />
 <input
 id="input-company"
 type="text"
 placeholder="Company *"
 required
 class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
 />
 <input
 id="input-name"
 type="text"
 placeholder="Name (optional)"
 class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
 />
 </div>
 <p id="email-error" class="hidden text-sm text-red-600">Please enter a valid work email and company name.</p>
 <button
 id="submit-email"
 type="submit"
 class="mt-2 inline-flex w-full items-center justify-center rounded-full bg-slate-950 px-8 py-4 text-base font-semibold text-white transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
 >
 Show My Results
 <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
 </button>
 </form>

 <div class="mt-6 flex items-center justify-between">
 <button id="back-5" type="button" class="nav-back-btn">
 <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m11 5-7 7 7 7"/></svg>
 Back
 </button>
 <p class="text-xs text-slate-400">No spam. We'll use this to send your results.</p>
 </div>
 </div>
 </div>

 <!-- ===================== SCREEN 6: RESULTS ===================== -->
 <div id="s6" class="screen hidden">

 <!-- Score hero -->
 <section class="border-b border-slate-100 bg-gradient-to-b from-white to-slate-50 px-5 py-16 lg:px-8 lg:py-20">
 <div class="mx-auto max-w-3xl">
 <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-start">
 <!-- Score ring -->
 <div class="flex-shrink-0 text-center">
