---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "RevTel.AI — Revenue Intelligence for B2B SaaS",
  description = "RevTel.AI is an omnichannel support system with native revenue intelligence. See stalled adoption, product friction, silent churn, and expansion risk hiding inside everyday support interactions.",
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
