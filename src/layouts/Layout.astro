---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "MeridianARR | Value Continuity Platform for B2B SaaS",
  description = "MeridianARR is a Value Continuity platform for B2B SaaS companies. Detect customer distress, product friction, support risk, and renewal threats before they become churn, contraction, or failed renewals.",
  canonical,
} = Astro.props;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MeridianARR",
  url: "https://meridianarr.com",
  description:
    "MeridianARR is a Value Continuity platform for B2B SaaS companies, connecting support, onboarding, product friction, customer distress, and renewal risk into post-sale revenue intelligence.",
  // Add sameAs URLs to LinkedIn, Crunchbase, G2, and Product Hunt when available
  sameAs: [],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="MeridianARR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Organization schema (global) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(orgSchema)}
    />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
