---
import Icon from "./Icon.astro";

const btn = "inline-flex items-center justify-center rounded-2xl px-6 py-3 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2";
const btnPrimary = `${btn} bg-slate-950 text-white hover:bg-slate-800`;
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
    <a href="/" class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-950 text-white">
        <Icon name="barChart" class="h-5 w-5" />
      </div>
      <div>
        <p class="text-lg font-semibold tracking-tight">Meridian</p>
        <p class="hidden text-xs font-medium uppercase tracking-[0.18em] text-slate-400 sm:block">Revenue Intelligence</p>
      </div>
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
      <a href="/" class="hover:text-slate-950">Overview</a>
      <a href="/#cdi" class="hover:text-slate-950">CDI</a>
      <a href="/#motions" class="hover:text-slate-950">ARR Motions</a>
      <a href="/compare/meridian-vs-pylon-zendesk-salesforce/" class="hover:text-slate-950">Compare</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="https://calendly.com/jonathanlapinsky1/30min" class={`hidden sm:inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2`}>
        Book a demo
      </a>
      <a href="https://meridianarr.com/customer-defensibility-score/" class={`${btnPrimary} rounded-full px-5 py-2.5`}>
        Calculate Your Defensibility Score
      </a>
    </div>
  </div>
</header>
