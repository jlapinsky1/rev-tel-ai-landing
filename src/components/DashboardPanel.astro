---
import Icon from "./Icon.astro";
import { riskSignals, accounts } from "../data/content.js";

const badgeClass: Record<string, string> = {
  "Silent churn": "badge-amber",
  "Ghosting":     "badge-indigo",
  "Healthy":      "badge-green",
  "Expansion":    "badge-slate",
};

const barClass: Record<string, string> = {
  risk:  "bar-amber",
  warn:  "bar-blue",
  muted: "bar-muted",
};
---

<div class="dash-root select-none">

  <!-- Header -->
  <div class="dash-header">
    <div>
      <p class="dash-eyebrow">Revenue Risk Monitor</p>
      <p class="dash-subtitle">Account-level post-sale intelligence</p>
    </div>
    <span class="risks-pill">
      <span class="risks-dot"></span>
      3 risks detected
    </span>
  </div>

  <!-- Body -->
  <div class="dash-body">

    <!-- Left: CDI + signals -->
    <div class="dash-left">
      <p class="cdi-label">Customer distress index</p>
      <div class="cdi-row">
        <span class="cdi-number">74</span>
        <span class="elevated-badge">Elevated</span>
      </div>
      <div class="signal-list">
        {riskSignals.map((signal) => (
          <div class="signal-item">
            <div class="signal-meta">
              <span class="signal-name">{signal.name}</span>
              <span class="signal-pct">{signal.value}%</span>
            </div>
            <div class="bar-track">
              <div class={`bar-fill ${barClass[signal.tone] ?? "bar-muted"}`} style={`--w:${signal.value}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Divider -->
    <div class="dash-divider"></div>

    <!-- Right: Accounts -->
    <div class="dash-right">
      <div class="accounts-hd">
        <p class="accounts-label">Accounts to watch</p>
      </div>
      <div class="accounts-list">
        {accounts.map((account) => (
          <div class="account-row">
            <div>
              <p class="account-name">{account.name}</p>
              <p class="account-arr">ARR {account.arr}</p>
            </div>
            <span class={`acct-badge ${badgeClass[account.status] ?? "badge-slate"}`}>{account.status}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</div>

<style>
  /* ─── Root ─────────────────────────────────────────────────────── */
  .dash-root {
    background: #13151e;
    border-radius: 1.5rem;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
    box-shadow: 0 32px 64px -16px rgba(0,0,0,0.5);
  }

  /* ─── Header ────────────────────────────────────────────────────── */
  .dash-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 22px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .dash-eyebrow {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .2em;
    color: #64748b;
  }
  .dash-subtitle {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 500;
    color: #e2e8f0;
  }
  .risks-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(245,158,11,0.15);
    border: 1px solid rgba(245,158,11,0.25);
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    color: #fbbf24;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .risks-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #f59e0b;
    animation: pulseDot 2s ease-in-out infinite;
  }

  /* ─── Body grid ─────────────────────────────────────────────────── */
  .dash-body {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
  }
  @media (max-width: 560px) {
    .dash-body { grid-template-columns: 1fr; }
    .dash-divider { display: none; }
  }
  .dash-divider { background: rgba(255,255,255,0.07); }

  /* ─── Left pane ─────────────────────────────────────────────────── */
  .dash-left { padding: 20px 22px; }
  .cdi-label {
    font-size: 12px;
    font-weight: 500;
    color: #64748b;
    margin-bottom: 8px;
  }
  .cdi-row {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 20px;
  }
  .cdi-number {
    font-size: 64px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -.04em;
  }
  .elevated-badge {
    margin-bottom: 8px;
    display: inline-block;
    background: rgba(180,120,10,0.35);
    color: #fbbf24;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 99px;
  }

  /* ─── Signal bars ────────────────────────────────────────────────── */
  .signal-list { display: flex; flex-direction: column; gap: 12px; }
  .signal-item {}
  .signal-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .signal-name { font-size: 12px; font-weight: 500; color: #cbd5e1; }
  .signal-pct  { font-size: 12px; color: #64748b; }
  .bar-track {
    height: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 99px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 99px;
    width: var(--w);
  }
  .bar-amber { background: #f59e0b; }
  .bar-blue  { background: #6366f1; }
  .bar-muted { background: #475569; }

  /* ─── Right pane ─────────────────────────────────────────────────── */
  .dash-right { padding: 20px 22px; }
  .accounts-hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .accounts-label { font-size: 13px; font-weight: 500; color: #94a3b8; }
  .eye-icon { width: 16px; height: 16px; color: #475569; }
  .accounts-list { display: flex; flex-direction: column; gap: 10px; }
  .account-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .account-name { font-size: 14px; font-weight: 600; color: #f1f5f9; }
  .account-arr  { font-size: 11px; color: #64748b; margin-top: 2px; }

  /* ─── Account badges ─────────────────────────────────────────────── */
  .acct-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 99px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .badge-amber  { background: rgba(180,110,0,0.4);    color: #fbbf24; }
  .badge-indigo { background: rgba(99,102,241,0.25);  color: #a5b4fc; }
  .badge-green  { background: rgba(16,185,129,0.2);   color: #6ee7b7; }
  .badge-slate  { background: rgba(99,102,241,0.2);   color: #93c5fd; }

  /* ─── Animations ─────────────────────────────────────────────────── */
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: .5; transform: scale(.75); }
  }
</style>
