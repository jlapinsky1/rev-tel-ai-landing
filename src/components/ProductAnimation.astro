---
// Dark-mode product mockup, customer detail view
---

<div class="product-anim-root select-none" aria-hidden="true">

 <!-- Customer header bar -->
 <div class="customer-header anim-fade-up" style="animation-delay:.1s">
 <div class="customer-header-left">
 <div class="customer-avatar">D</div>
 <div>
 <p class="customer-name">DBInc</p>
 <p class="customer-crumb">Customers &rsaquo; DBInc</p>
 </div>
 </div>
 <div class="customer-header-right">
 <div class="kpi-chip">
 <span class="kpi-label">Total ARR</span>
 <span class="kpi-value">$400,000</span>
 </div>
 <div class="kpi-chip">
 <span class="kpi-label">Last Contact</span>
 <span class="kpi-value">Jan 22, 2025</span>
 </div>
 </div>
 </div>

 <!-- Main grid -->
 <div class="main-grid">

 <!-- Left col -->
 <div class="left-col">

 <!-- Value Continuity card -->
 <div class="card anim-fade-up" style="animation-delay:.25s">
 <div class="card-header">
 <span class="section-eyebrow">Value Continuity</span>
 <span class="status-badge status-warn">
 <span class="status-dot"></span>
 Weakening
 </span>
 </div>
 <div class="signal-list">
 <div class="signal-row anim-fade-up" style="animation-delay:.5s">
 <div class="signal-meta">
 <span class="signal-name">Escalated sentiment language</span>
 <span class="signal-pct">72%</span>
 </div>
 <div class="bar-track">
 <div class="bar-fill bar-amber" style="--target:72%"></div>
 </div>
 </div>
 <div class="signal-row anim-fade-up" style="animation-delay:.65s">
 <div class="signal-meta">
 <span class="signal-name">Delayed activation</span>
 <span class="signal-pct">48%</span>
 </div>
 <div class="bar-track">
 <div class="bar-fill bar-blue" style="--target:48%"></div>
 </div>
 </div>
 <div class="signal-row anim-fade-up" style="animation-delay:.8s">
 <div class="signal-meta">
 <span class="signal-name">Unresolved reporting friction</span>
 <span class="signal-pct">31%</span>
 </div>
 <div class="bar-track">
 <div class="bar-fill bar-slate" style="--target:31%"></div>
 </div>
 </div>
 </div>
 <div class="recommended-motion anim-fade-up" style="animation-delay:.95s">
 <span class="motion-label">Recommended motion</span>
 <span class="motion-value">Adoption recovery &rsaquo;</span>
 </div>
 </div>

 <!-- Opportunities card -->
 <div class="card anim-fade-up" style="animation-delay:.4s">
 <div class="card-header">
 <span class="section-eyebrow">Opportunities</span>
 <span class="opp-meta">6 open &middot; $148K potential</span>
 </div>
 <div class="opp-list">
 <div class="opp-row anim-fade-up" style="animation-delay:.7s">
 <div class="opp-icon opp-icon-blue">↑</div>
 <div class="opp-body">
 <p class="opp-title">Premium Support Upgrade</p>
 <p class="opp-subtitle">Upsell &middot; $52K ARR</p>
 </div>
 <span class="conf-badge conf-high">High</span>
 </div>
 <div class="opp-row anim-fade-up" style="animation-delay:.85s">
 <div class="opp-icon opp-icon-teal">+</div>
 <div class="opp-body">
 <p class="opp-title">Knowledge Base Add-on</p>
 <p class="opp-subtitle">Cross-sell &middot; $36K ARR</p>
 </div>
 <span class="conf-badge conf-med">Medium</span>
 </div>
 <div class="opp-row anim-fade-up" style="animation-delay:1s">
 <div class="opp-icon opp-icon-blue">⊙</div>
 <div class="opp-body">
 <p class="opp-title">Additional Seats + Automation</p>
 <p class="opp-subtitle">Usage increase &middot; $60K ARR</p>
 </div>
 <span class="conf-badge conf-high">High</span>
 </div>
 </div>
 </div>

 </div>

 <!-- Right col -->
 <div class="right-col">

 <!-- Product adoption card -->
 <div class="card anim-fade-up" style="animation-delay:.35s">
 <div class="card-header">
 <span class="section-eyebrow">Product Adoption</span>
 <span class="adoption-meta">Last 30 days</span>
 </div>
 <div class="adoption-metrics">
 <div class="adoption-kpi anim-fade-up" style="animation-delay:.6s">
 <span class="adoption-num">24</span>
 <span class="adoption-label">Active users</span>
 </div>
 <div class="adoption-kpi anim-fade-up" style="animation-delay:.7s">
 <span class="adoption-num">4/7</span>
 <span class="adoption-label">Features adopted</span>
 </div>
 <div class="adoption-kpi adoption-kpi-warn anim-fade-up" style="animation-delay:.8s">
 <span class="adoption-num">71%</span>
 <span class="adoption-label">Usage breadth</span>
 </div>
 </div>
 <div class="feature-adoption anim-fade-up" style="animation-delay:.9s">
 <p class="feature-adoption-header">Core Feature Adoption</p>
 <div class="feature-row">
 <span class="feature-name">Messaging</span>
 <div class="bar-track bar-track-sm">
 <div class="bar-fill bar-blue-solid" style="--target:82%"></div>
 </div>
 <span class="feature-pct">82%</span>
 </div>
 <div class="feature-row">
 <span class="feature-name">Knowledge base</span>
 <div class="bar-track bar-track-sm">
 <div class="bar-fill bar-teal-solid" style="--target:68%"></div>
 </div>
 <span class="feature-pct">68%</span>
 </div>
 <div class="feature-row">
 <span class="feature-name">Workflow automation</span>
 <div class="bar-track bar-track-sm">
 <div class="bar-fill bar-blue-solid" style="--target:41%"></div>
 </div>
 <span class="feature-pct">41%</span>
 </div>
 <div class="feature-row">
 <span class="feature-name">Reporting</span>
 <div class="bar-track bar-track-sm">
 <div class="bar-fill bar-amber-solid" style="--target:24%"></div>
 </div>
 <span class="feature-pct">24%</span>
 </div>
 </div>
 </div>

 <!-- Touchpoints card -->
 <div class="card anim-fade-up" style="animation-delay:.55s">
 <div class="card-header">
 <span class="section-eyebrow">Latest Touchpoints</span>
 <button class="add-tp-btn">+ Add touchpoint</button>
 </div>
 <div class="tp-list">
 <div class="tp-row anim-fade-up" style="animation-delay:.75s">
 <span class="tp-type-badge tp-email">Email</span>
 <div class="tp-body">
 <p class="tp-title">Possible 1 Year Renewal</p>
 <p class="tp-date">1/22/2025</p>
 </div>
 </div>
 <div class="tp-row anim-fade-up" style="animation-delay:.88s">
 <span class="tp-type-badge tp-call">Call</span>
 <div class="tp-body">
 <p class="tp-title">CS, Monthly Call</p>
 <p class="tp-date">7/22/2024</p>
 </div>
 </div>
 <div class="tp-row anim-fade-up" style="animation-delay:1.01s">
 <span class="tp-type-badge tp-call">Call</span>
 <div class="tp-body">
 <p class="tp-title">Churn Convo with Daniela</p>
 <p class="tp-date">5/23/2024</p>
 </div>
 </div>
 <div class="tp-row anim-fade-up" style="animation-delay:1.14s">
 <span class="tp-type-badge tp-cs">CS</span>
 <div class="tp-body">
 <p class="tp-title">CS, Customer Touchpoint</p>
 <p class="tp-date">5/23/2024</p>
 </div>
 </div>
 </div>
 </div>

 </div>
 </div>

</div>

<style>
 /* ─── Root ─────────────────────────────────────────────────────────── */
 .product-anim-root {
 position: relative;
 width: 100%;
 font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
 }

 /* ─── Customer header ───────────────────────────────────────────── */
 .customer-header {
 display: flex;
 align-items: center;
 justify-content: space-between;
 padding: 4px 4px 20px;
 flex-wrap: wrap;
 gap: 12px;
 }
 .customer-header-left { display: flex; align-items: center; gap: 12px; }
 .customer-avatar {
 width: 48px; height: 48px;
 border-radius: 12px;
 background: #6366f1;
 color: white;
 display: flex; align-items: center; justify-content: center;
 font-size: 20px; font-weight: 700;
 }
 .customer-name { font-size: 20px; font-weight: 700; color: #ffffff; }
 .customer-crumb { font-size: 11px; color: #64748b; margin-top: 2px; }
 .customer-header-right { display: flex; gap: 28px; flex-wrap: wrap; }
 .kpi-chip { text-align: right; }
 .kpi-label { display: block; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .16em; color: #64748b; }
 .kpi-value { display: block; font-size: 22px; font-weight: 700; color: #ffffff; margin-top: 3px; letter-spacing: -.02em; }

 /* ─── Main grid ─────────────────────────────────────────────────── */
 .main-grid {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 12px;
 }
 @media (max-width: 640px) {
 .main-grid { grid-template-columns: 1fr; }
 }
 .left-col, .right-col { display: flex; flex-direction: column; gap: 12px; }

 /* ─── Card ──────────────────────────────────────────────────────── */
 .card {
 background: rgba(255,255,255,0.06);
 border-radius: 1rem;
 border: 1px solid rgba(255,255,255,0.1);
 padding: 16px;
 }
 .card-header {
 display: flex;
 align-items: center;
 justify-content: space-between;
 margin-bottom: 14px;
 }
 .section-eyebrow {
 font-size: 9px;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: .2em;
 color: #64748b;
 }

 /* ─── Status badge ──────────────────────────────────────────────── */
 .status-badge {
 display: inline-flex;
 align-items: center;
 gap: 5px;
 font-size: 10px;
 font-weight: 600;
 padding: 3px 9px;
 border-radius: 99px;
 }
 .status-warn {
 background: rgba(245,158,11,0.18);
 color: #fbbf24;
 }
 .status-dot {
 width: 6px; height: 6px;
 border-radius: 50%;
 background: #f59e0b;
 animation: pulseDot 1.8s ease-in-out infinite;
 }

 /* ─── Signal bars ───────────────────────────────────────────────── */
 .signal-list { display: flex; flex-direction: column; gap: 10px; }
 .signal-meta { display: flex; justify-content: space-between; margin-bottom: 5px; }
 .signal-name { font-size: 11px; font-weight: 500; color: #cbd5e1; }
 .signal-pct { font-size: 11px; color: #64748b; }
 .bar-track {
 height: 6px;
 background: rgba(255,255,255,0.08);
 border-radius: 99px;
 overflow: hidden;
 }
 .bar-track-sm { height: 5px; }
 .bar-fill {
 height: 100%;
 border-radius: 99px;
 width: 0%;
 animation: fillBar 1.4s cubic-bezier(.22,1,.36,1) forwards;
 }
 .bar-amber { background: #f59e0b; }
 .bar-blue { background: #3b82f6; }
 .bar-slate { background: #475569; }
 .bar-blue-solid { background: #3b82f6; }
 .bar-teal-solid { background: #10b981; }
 .bar-amber-solid { background: #f59e0b; }

 /* ─── Recommended motion ────────────────────────────────────────── */
 .recommended-motion {
 display: flex;
 align-items: center;
 justify-content: space-between;
 margin-top: 14px;
 background: rgba(99,102,241,0.18);
 border: 1px solid rgba(99,102,241,0.3);
 border-radius: .75rem;
 padding: 10px 14px;
 }
 .motion-label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; color: #818cf8; }
 .motion-value { font-size: 12px; font-weight: 600; color: #c7d2fe; }

 /* ─── Opportunities ─────────────────────────────────────────────── */
 .opp-meta { font-size: 10px; color: #64748b; }
 .opp-list { display: flex; flex-direction: column; gap: 10px; }
 .opp-row { display: flex; align-items: center; gap: 10px; }
 .opp-icon {
 width: 32px; height: 32px;
 border-radius: 9px;
 display: flex; align-items: center; justify-content: center;
 font-size: 14px; font-weight: 700; flex-shrink: 0;
 }
 .opp-icon-blue { background: rgba(59,130,246,0.18); color: #60a5fa; }
 .opp-icon-teal { background: rgba(16,185,129,0.18); color: #34d399; }
 .opp-body { flex: 1; min-width: 0; }
 .opp-title { font-size: 12px; font-weight: 600; color: #f1f5f9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 .opp-subtitle { font-size: 10px; color: #64748b; margin-top: 2px; }
 .conf-badge {
 font-size: 9px; font-weight: 700;
 padding: 3px 8px;
 border-radius: 99px;
 white-space: nowrap;
 }
 .conf-high { background: rgba(239,68,68,0.2); color: #f87171; }
 .conf-med { background: rgba(245,158,11,0.2); color: #fbbf24; }

 /* ─── Adoption metrics ──────────────────────────────────────────── */
 .adoption-meta { font-size: 10px; color: #64748b; }
 .adoption-metrics { display: flex; gap: 8px; margin-bottom: 14px; }
 .adoption-kpi {
 flex: 1;
 background: rgba(255,255,255,0.05);
 border-radius: .75rem;
 border: 1px solid rgba(255,255,255,0.08);
 padding: 10px;
 text-align: center;
 }
 .adoption-kpi-warn .adoption-num { color: #f59e0b; }
 .adoption-num {
 display: block;
 font-size: 20px; font-weight: 700; color: #ffffff;
 line-height: 1;
 }
 .adoption-label {
 display: block;
 font-size: 8px; font-weight: 600;
 text-transform: uppercase;
 letter-spacing: .1em;
 color: #64748b;
 margin-top: 4px;
 }
 .feature-adoption-header {
 font-size: 9px; font-weight: 700;
 text-transform: uppercase; letter-spacing: .16em;
 color: #64748b; margin-bottom: 10px;
 }
 .feature-adoption { display: flex; flex-direction: column; gap: 8px; }
 .feature-row {
 display: grid;
 grid-template-columns: 1fr auto auto;
 align-items: center;
 gap: 10px;
 }
 .feature-name { font-size: 11px; font-weight: 500; color: #cbd5e1; white-space: nowrap; }
 .feature-pct { font-size: 10px; color: #64748b; width: 28px; text-align: right; }
 .feature-row .bar-track { width: 70px; }

 /* ─── Touchpoints ───────────────────────────────────────────────── */
 .add-tp-btn {
 font-size: 10px; font-weight: 600;
 color: #60a5fa;
 background: rgba(59,130,246,0.12);
 border: 1px solid rgba(59,130,246,0.3);
 border-radius: 8px;
 padding: 4px 10px;
 cursor: default;
 letter-spacing: .01em;
 }
 .tp-list { display: flex; flex-direction: column; gap: 10px; }
 .tp-row { display: flex; align-items: center; gap: 10px; }
 .tp-type-badge {
 font-size: 8px; font-weight: 700;
 text-transform: uppercase; letter-spacing: .12em;
 padding: 3px 8px; border-radius: 99px;
 white-space: nowrap;
 }
 .tp-email { background: rgba(37,99,235,0.25); color: #93c5fd; }
 .tp-call { background: rgba(16,185,129,0.2); color: #6ee7b7; }
 .tp-cs { background: rgba(255,255,255,0.08); color: #94a3b8; }
 .tp-body { flex: 1; min-width: 0; }
 .tp-title { font-size: 11px; font-weight: 500; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 .tp-date { font-size: 10px; color: #64748b; margin-top: 2px; }

 /* ─── Animations ────────────────────────────────────────────────── */
 @keyframes fillBar {
 from { width: 0%; }
 to { width: var(--target); }
 }
 @keyframes pulseDot {
 0%, 100% { opacity: 1; transform: scale(1); }
 50% { opacity: .5; transform: scale(.7); }
 }
 @keyframes fadeSlideUp {
 from { opacity: 0; transform: translateY(12px); }
 to { opacity: 1; transform: translateY(0); }
 }
 .anim-fade-up {
 opacity: 0;
 animation: fadeSlideUp .55s cubic-bezier(.22,1,.36,1) forwards;
 }
</style>
