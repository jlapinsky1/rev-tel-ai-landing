---
// Animated product mockup — customer detail view in Meridian color palette
---

<div class="product-anim-root select-none" aria-hidden="true">

  <!-- Window chrome -->
  <div class="window-chrome">
    <div class="window-dots">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <div class="window-address">app.meridianarr.com / customers / DBInc</div>
  </div>

  <!-- Customer header bar -->
  <div class="customer-header anim-fade-up" style="animation-delay:.1s">
    <div class="customer-header-left">
      <div class="customer-avatar">D</div>
      <div>
        <p class="customer-name">DBInc</p>
        <p class="customer-crumb">Customers &rsaquo; DBInc</p>
      </div>
    </div>
    <div class="customer-header-right">
      <div class="kpi-chip">
        <span class="kpi-label">Total ARR</span>
        <span class="kpi-value arr-count">$400,000</span>
      </div>
      <div class="kpi-chip">
        <span class="kpi-label">Last Contact</span>
        <span class="kpi-value">1/22/2025</span>
      </div>
    </div>
  </div>

  <!-- Main grid -->
  <div class="main-grid">

    <!-- Left col -->
    <div class="left-col">

      <!-- Value Continuity card -->
      <div class="card anim-fade-up" style="animation-delay:.25s">
        <div class="card-header">
          <span class="section-eyebrow">Value Continuity</span>
          <span class="status-badge status-warn">
            <span class="status-dot"></span>
            Weakening
          </span>
        </div>
        <div class="signal-list">
          <div class="signal-row anim-fade-up" style="animation-delay:.5s">
            <div class="signal-meta">
              <span class="signal-name">Escalated sentiment language</span>
              <span class="signal-pct">72%</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill bar-amber" style="--target:72%"></div>
            </div>
          </div>
          <div class="signal-row anim-fade-up" style="animation-delay:.65s">
            <div class="signal-meta">
              <span class="signal-name">Delayed activation</span>
              <span class="signal-pct">48%</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill bar-blue" style="--target:48%"></div>
            </div>
          </div>
          <div class="signal-row anim-fade-up" style="animation-delay:.8s">
            <div class="signal-meta">
              <span class="signal-name">Unresolved reporting friction</span>
              <span class="signal-pct">31%</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill bar-slate" style="--target:31%"></div>
            </div>
          </div>
        </div>
        <div class="recommended-motion anim-fade-up" style="animation-delay:.95s">
          <span class="motion-label">Recommended motion</span>
          <span class="motion-value">Adoption recovery &rsaquo;</span>
        </div>
      </div>

      <!-- Opportunities card -->
      <div class="card anim-fade-up" style="animation-delay:.4s">
        <div class="card-header">
          <span class="section-eyebrow">Opportunities</span>
          <span class="opp-meta">6 open &middot; $148K potential</span>
        </div>
        <div class="opp-list">
          <div class="opp-row anim-fade-up" style="animation-delay:.7s">
            <div class="opp-icon opp-icon-blue">↑</div>
            <div class="opp-body">
              <p class="opp-title">Premium Support Upgrade</p>
              <p class="opp-subtitle">Upsell &middot; $52K ARR</p>
            </div>
            <span class="conf-badge conf-high">High</span>
          </div>
          <div class="opp-row anim-fade-up" style="animation-delay:.85s">
            <div class="opp-icon opp-icon-teal">+</div>
            <div class="opp-body">
              <p class="opp-title">Knowledge Base Add-on</p>
              <p class="opp-subtitle">Cross-sell &middot; $36K ARR</p>
            </div>
            <span class="conf-badge conf-med">Medium</span>
          </div>
          <div class="opp-row anim-fade-up" style="animation-delay:1s">
            <div class="opp-icon opp-icon-blue">⟳</div>
            <div class="opp-body">
              <p class="opp-title">Additional Seats + Automation</p>
              <p class="opp-subtitle">Usage increase &middot; $60K ARR</p>
            </div>
            <span class="conf-badge conf-high">High</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Right col -->
    <div class="right-col">

      <!-- Product adoption card -->
      <div class="card anim-fade-up" style="animation-delay:.35s">
        <div class="card-header">
          <span class="section-eyebrow">Product Adoption</span>
          <span class="adoption-meta">Last 30 days</span>
        </div>
        <div class="adoption-metrics">
          <div class="adoption-kpi anim-fade-up" style="animation-delay:.6s">
            <span class="adoption-num">24</span>
            <span class="adoption-label">Active users</span>
          </div>
          <div class="adoption-kpi anim-fade-up" style="animation-delay:.7s">
            <span class="adoption-num">4/7</span>
            <span class="adoption-label">Features adopted</span>
          </div>
          <div class="adoption-kpi adoption-kpi-warn anim-fade-up" style="animation-delay:.8s">
            <span class="adoption-num">71%</span>
            <span class="adoption-label">Usage breadth</span>
          </div>
        </div>
        <div class="feature-adoption anim-fade-up" style="animation-delay:.9s">
          <p class="feature-adoption-header">Core Feature Adoption</p>
          <div class="feature-row">
            <span class="feature-name">Messaging</span>
            <div class="bar-track bar-track-sm">
              <div class="bar-fill bar-blue-solid" style="--target:82%"></div>
            </div>
            <span class="feature-pct">82%</span>
          </div>
          <div class="feature-row">
            <span class="feature-name">Knowledge Base</span>
            <div class="bar-track bar-track-sm">
              <div class="bar-fill bar-teal-solid" style="--target:68%"></div>
            </div>
            <span class="feature-pct">68%</span>
          </div>
          <div class="feature-row">
            <span class="feature-name">Workflow Automation</span>
            <div class="bar-track bar-track-sm">
              <div class="bar-fill bar-blue-solid" style="--target:41%"></div>
            </div>
            <span class="feature-pct">41%</span>
          </div>
          <div class="feature-row">
            <span class="feature-name">Reporting</span>
            <div class="bar-track bar-track-sm">
              <div class="bar-fill bar-amber-solid" style="--target:24%"></div>
            </div>
            <span class="feature-pct">24%</span>
          </div>
        </div>
      </div>

      <!-- Touchpoints card -->
      <div class="card anim-fade-up" style="animation-delay:.55s">
        <div class="card-header">
          <span class="section-eyebrow">Latest Touchpoints</span>
          <button class="add-tp-btn">+ Add Touchpoint</button>
        </div>
        <div class="tp-list">
          <div class="tp-row anim-fade-up" style="animation-delay:.75s">
            <span class="tp-type-badge tp-email">Email</span>
            <div class="tp-body">
              <p class="tp-title">Possible 1 Year Renewal</p>
              <p class="tp-date">1/22/2025</p>
            </div>
          </div>
          <div class="tp-row anim-fade-up" style="animation-delay:.88s">
            <span class="tp-type-badge tp-call">Call</span>
            <div class="tp-body">
              <p class="tp-title">CS — Monthly Call</p>
              <p class="tp-date">7/22/2024</p>
            </div>
          </div>
          <div class="tp-row anim-fade-up" style="animation-delay:1.01s">
            <span class="tp-type-badge tp-call">Call</span>
            <div class="tp-body">
              <p class="tp-title">Churn Convo with Daniela</p>
              <p class="tp-date">5/23/2024</p>
            </div>
          </div>
          <div class="tp-row anim-fade-up" style="animation-delay:1.14s">
            <span class="tp-type-badge tp-cs">CS</span>
            <div class="tp-body">
              <p class="tp-title">CS — Customer Touchpoint</p>
              <p class="tp-date">5/23/2024</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom glow line -->
  <div class="bottom-scanner"></div>

</div>

<style>
  /* ─── Root ─────────────────────────────────────────────────────────── */
  .product-anim-root {
    position: relative;
    width: 100%;
    background: #f8fafc;
    border-radius: 1.5rem;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 25px 60px -12px rgba(15,23,42,0.12), 0 0 0 1px rgba(255,255,255,0.8) inset;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
  }

  /* ─── Window chrome ──────────────────────────────────────────────── */
  .window-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }
  .window-dots { display: flex; gap: 6px; }
  .dot {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .dot-red    { background: #fc605c; }
  .dot-yellow { background: #fdbc40; }
  .dot-green  { background: #35cd4b; }
  .window-address {
    flex: 1;
    background: #f1f5f9;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 10px;
    color: #64748b;
    letter-spacing: .01em;
  }

  /* ─── Customer header ───────────────────────────────────────────── */
  .customer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: #ffffff;
    border-bottom: 1px solid #f1f5f9;
    flex-wrap: wrap;
    gap: 10px;
  }
  .customer-header-left { display: flex; align-items: center; gap: 10px; }
  .customer-avatar {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #3b82f6, #0ea5e9);
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 700;
  }
  .customer-name { font-size: 15px; font-weight: 700; color: #0f172a; }
  .customer-crumb { font-size: 10px; color: #94a3b8; margin-top: 1px; }
  .customer-header-right { display: flex; gap: 12px; flex-wrap: wrap; }
  .kpi-chip {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 6px 12px;
  }
  .kpi-label { display: block; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .12em; color: #94a3b8; }
  .kpi-value { display: block; font-size: 13px; font-weight: 700; color: #0f172a; margin-top: 2px; }

  /* ─── Main grid ─────────────────────────────────────────────────── */
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 12px;
  }
  @media (max-width: 640px) {
    .main-grid { grid-template-columns: 1fr; }
  }
  .left-col, .right-col { display: flex; flex-direction: column; gap: 12px; }

  /* ─── Card ──────────────────────────────────────────────────────── */
  .card {
    background: #ffffff;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    padding: 14px 16px;
    box-shadow: 0 1px 4px rgba(15,23,42,.04);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .section-eyebrow {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: #64748b;
  }

  /* ─── Status badge ──────────────────────────────────────────────── */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 99px;
  }
  .status-warn {
    background: #fef3c7;
    color: #92400e;
  }
  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #f59e0b;
    animation: pulseDot 1.8s ease-in-out infinite;
  }

  /* ─── Signal bars ───────────────────────────────────────────────── */
  .signal-list { display: flex; flex-direction: column; gap: 10px; }
  .signal-row {}
  .signal-meta { display: flex; justify-content: space-between; margin-bottom: 5px; }
  .signal-name { font-size: 10px; font-weight: 500; color: #475569; }
  .signal-pct  { font-size: 10px; color: #94a3b8; }
  .bar-track {
    height: 6px;
    background: #f1f5f9;
    border-radius: 99px;
    overflow: hidden;
  }
  .bar-track-sm { height: 5px; }
  .bar-fill {
    height: 100%;
    border-radius: 99px;
    width: 0%;
    animation: fillBar 1.4s cubic-bezier(.22,1,.36,1) forwards;
  }
  .bar-amber       { background: #f59e0b; }
  .bar-blue        { background: #3b82f6; }
  .bar-slate       { background: #94a3b8; }
  .bar-blue-solid  { background: #3b82f6; }
  .bar-teal-solid  { background: #0d9488; }
  .bar-amber-solid { background: #f59e0b; }

  /* ─── Recommended motion ────────────────────────────────────────── */
  .recommended-motion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: .75rem;
    padding: 8px 12px;
  }
  .motion-label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: #3b82f6; }
  .motion-value { font-size: 11px; font-weight: 600; color: #1e40af; }

  /* ─── Opportunities ─────────────────────────────────────────────── */
  .opp-meta  { font-size: 10px; color: #64748b; }
  .opp-list  { display: flex; flex-direction: column; gap: 8px; }
  .opp-row   { display: flex; align-items: center; gap: 8px; }
  .opp-icon  {
    width: 28px; height: 28px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700; flex-shrink: 0;
  }
  .opp-icon-blue { background: #eff6ff; color: #3b82f6; }
  .opp-icon-teal { background: #f0fdfa; color: #0d9488; }
  .opp-body  { flex: 1; min-width: 0; }
  .opp-title { font-size: 11px; font-weight: 600; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .opp-subtitle { font-size: 9px; color: #64748b; margin-top: 1px; }
  .conf-badge {
    font-size: 9px; font-weight: 700;
    padding: 2px 7px;
    border-radius: 99px;
    white-space: nowrap;
  }
  .conf-high { background: #dcfce7; color: #166534; }
  .conf-med  { background: #fef9c3; color: #854d0e; }

  /* ─── Adoption metrics ──────────────────────────────────────────── */
  .adoption-meta { font-size: 10px; color: #64748b; }
  .adoption-metrics { display: flex; gap: 8px; margin-bottom: 12px; }
  .adoption-kpi {
    flex: 1;
    background: #f8fafc;
    border-radius: .75rem;
    border: 1px solid #e2e8f0;
    padding: 8px 10px;
    text-align: center;
  }
  .adoption-kpi-warn { border-color: #fde68a; background: #fffbeb; }
  .adoption-num {
    display: block;
    font-size: 16px; font-weight: 700; color: #0f172a;
    line-height: 1;
  }
  .adoption-label {
    display: block;
    font-size: 8px; font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: #94a3b8;
    margin-top: 3px;
  }
  .feature-adoption-header {
    font-size: 9px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .14em;
    color: #94a3b8; margin-bottom: 8px;
  }
  .feature-adoption { display: flex; flex-direction: column; gap: 7px; }
  .feature-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 8px;
  }
  .feature-name { font-size: 10px; font-weight: 500; color: #475569; white-space: nowrap; }
  .feature-pct  { font-size: 9px; color: #94a3b8; width: 26px; text-align: right; }
  .feature-row .bar-track { width: 60px; }

  /* ─── Touchpoints ───────────────────────────────────────────────── */
  .add-tp-btn {
    font-size: 9px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .12em;
    color: #3b82f6;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 3px 8px;
    cursor: default;
  }
  .tp-list { display: flex; flex-direction: column; gap: 6px; }
  .tp-row  { display: flex; align-items: center; gap: 8px; }
  .tp-type-badge {
    font-size: 8px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .1em;
    padding: 2px 7px; border-radius: 99px;
    white-space: nowrap;
  }
  .tp-email { background: #eff6ff; color: #2563eb; }
  .tp-call  { background: #f0fdfa; color: #0d9488; }
  .tp-cs    { background: #f8fafc; color: #475569; }
  .tp-body  { flex: 1; min-width: 0; }
  .tp-title { font-size: 10px; font-weight: 500; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tp-date  { font-size: 9px; color: #94a3b8; margin-top: 1px; }

  /* ─── Bottom scanner ────────────────────────────────────────────── */
  .bottom-scanner {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, #3b82f6 40%, #0d9488 60%, transparent 100%);
    animation: scanLine 3s ease-in-out infinite;
    opacity: .7;
  }

  /* ─── Animations ────────────────────────────────────────────────── */
  @keyframes fillBar {
    from { width: 0%; }
    to   { width: var(--target); }
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: .5; transform: scale(.7); }
  }
  @keyframes scanLine {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .anim-fade-up {
    opacity: 0;
    animation: fadeSlideUp .55s cubic-bezier(.22,1,.36,1) forwards;
  }
</style>
